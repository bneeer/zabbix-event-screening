# =============================================================================
# Zabbix Event Screening - environment configuration
# Copy to .env for local development. In Docker/Kubernetes, inject the same
# variables directly (real environment variables always win over this file).
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production                  # production | development
APP_TIMEZONE=UTC
# Where SQLite DB, screening reports and heartbeat live (mount a volume here)
APP_STORAGE_PATH=./storage
LOG_LEVEL=info                      # debug | info | warning | error
LOG_FORMAT=text                     # text | json

# --- Azure OpenAI ------------------------------------------------------------
AZURE_OPENAI_KEY=
AZURE_OPENAI_MODEL=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_BASE_URL=https://{your-resource}.openai.azure.com/
AZURE_OPENAI_RESOURCE_NAME=your-resource
AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large
AZURE_OPENAI_EMBEDDINGS_API_VERSION=2024-04-01-preview

# --- ServiceNOW --------------------------------------------------------------
SERVICENOW_INSTANCE_NAME=
SERVICENOW_INSTANCE_CUSTOM_URL=https://your-instance.service-now.com
SERVICENOW_INSTANCE_USER=
SERVICENOW_INSTANCE_PASSWORD=

# Daemon polling rule (ServiceNOW encoded query / sysparm_query).
# Every DAEMON_POLL_INTERVAL seconds the daemon fetches tickets matching this
# query and screens the ones not processed yet.
# Example: new incidents from the "Monitoring" assignment group, opened via Zabbix
SERVICENOW_POLL_TABLE=incident
SERVICENOW_POLL_QUERY=state=1^assignment_group.name=Monitoring^short_descriptionLIKEZabbix^ORDERBYsys_created_on
SERVICENOW_POLL_LIMIT=20
# Post the screening report back to the ticket (work_notes by default)
SERVICENOW_WRITE_BACK=false
SERVICENOW_WRITE_BACK_FIELD=work_notes

# --- Daemon ------------------------------------------------------------------
DAEMON_POLL_INTERVAL=60             # seconds between polls
DAEMON_MAX_ATTEMPTS=3               # give up on a ticket after N failures
DAEMON_RETRY_FAILED=true            # retry failed tickets on the next poll
DAEMON_RUN_ONCE=false               # process one poll cycle and exit (cron-style)
# DAEMON_HEARTBEAT_FILE=${APP_STORAGE_PATH}/daemon.heartbeat
# DAEMON_OUTPUT_DIR=${APP_STORAGE_PATH}/screenings

# --- Database ----------------------------------------------------------------
# Leave DB_HOST empty to use a local SQLite file (DB_SQLITE_PATH).
# Set DB_DRIVER to mysql or pgsql and provide credentials for a remote DB.
DB_DRIVER=                          # sqlite | mysql | pgsql (auto-detected when empty)
DB_HOST=
DB_PORT=
DB_NAME=zabbix_event_screening
DB_USER=
DB_PASSWORD=
DB_SQLITE_PATH=./storage/database.sqlite
DB_AUTO_CREATE=true                 # create database/schema when missing
# DB_SSL_CA=/certs/db-ca.pem        # CA bundle for TLS to MySQL/PostgreSQL

# --- Zabbix ------------------------------------------------------------------
ZABBIX_ENDPOINT=
ZABBIX_USER=
ZABBIX_PASSWORD=
ZABBIX_EXECUTION_TYPE=0

# --- Network / TLS -----------------------------------------------------------
PROXY=
# Certificate verification is always enabled. For internal CAs, point to a PEM bundle.
SSL_CA_BUNDLE=
SERVICENOW_CA_BUNDLE=
ZABBIX_CA_BUNDLE=
AZURE_OPENAI_CA_BUNDLE=
